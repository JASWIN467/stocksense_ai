# Auto detect text files and perform LF normalization
* text=auto

# Python, HTML, CSS, JS, Markdown, JSON, YAML files
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.pptx binary
*.joblib binary
*.db binary
*.sqlite binary
